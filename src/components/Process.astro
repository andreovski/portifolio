---
const steps = [
  { t: 'Descoberta', p: 'Entendo o negócio, mapeio os processos e encontro o que dá para automatizar.' },
  { t: 'Design', p: 'Telas pensadas primeiro para o celular, validadas com você antes de virar código.' },
  { t: 'Build', p: 'Entregas curtas que você testa toda semana, num link de verdade.' },
  { t: 'Lançamento', p: 'Publicação, métricas e ajustes com usuários reais.' },
];
---
<section class="sec pad" id="processo" data-act="04" data-name="Processo" data-accent="#9b6bff">
  <span class="cross l" aria-hidden="true">+</span><span class="cross r" aria-hidden="true">+</span>
  <div class="inner">
    <div class="sec-head">
      <span class="acc" data-scramble>/04</span>
      <h2 class="d up" data-scramble>Do primeiro papo ao produto no ar</h2>
      <span class="sec-tag" data-scramble>COMO EU TRABALHO</span>
    </div>
    <ol class="steps" data-rv="steps">
      {steps.map((s, i) => (
        <li style={`--d:${i}`}>
          <span class="step-n">PASSO_0{i + 1}</span>
          <h3 class="d up">{s.t}</h3>
          <p class="muted">{s.p}</p>
          <div class="seg" aria-hidden="true">
            {[0, 1, 2, 3].map((k) => <span class={k <= i ? 'on' : ''} style={`--k:${k}`}></span>)}
            <b>{i + 1}/4</b>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
