---
const links = [
  { href: '#inicio', label: 'Início', act: '00' },
  { href: '#manifesto', label: 'Manifesto', act: '01' },
  { href: '#servicos', label: 'Serviços', act: '02' },
  { href: '#projetos', label: 'Projetos', act: '03' },
  { href: '#processo', label: 'Processo', act: '04' },
  { href: '#contato', label: 'Contato', act: '05' },
];
---
<header class="top">
  <a class="brand btn-solid" href="#inicio" aria-label="Deco, início">
    <svg class="logo" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><g fill="currentColor"><rect x="0" y="0" width="5" height="18"></rect><rect x="13" y="0" width="5" height="18"></rect><rect x="5" y="6.5" width="8" height="5"></rect></g></svg>
    <span class="d">DECO<span class="blink">_</span></span>
  </a>
  <nav class="nav-links" aria-label="Seções">
    {links.map((l, i) => (
      <span class="nav-item">
        {i > 0 && <span class="plus" aria-hidden="true">+</span>}
        <a class="navlink" href={l.href} data-nav={l.act}>{l.label}</a>
      </span>
    ))}
  </nav>
  <div class="sys" aria-hidden="true">
    <span>SYS_TIME</span>
    <span class="sys-clock" data-clock="s">--:--:--</span>
    <span>BRT · UTC−3</span>
  </div>
  <a class="btn-solid cta-top" href="#contato"><span>Vamos conversar</span><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 11L11 3M5 3h6v6"></path></svg></a>
  <button class="menu-btn" id="menuBtn" type="button" aria-expanded="false" aria-controls="nav" aria-label="Abrir menu">
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14"></path></svg>
  </button>
</header>

<nav class="nav" id="nav" hidden aria-label="Menu">
  <div class="nav-head">
    <span class="lbl">ÍNDICE</span>
    <button class="menu-btn" id="closeBtn" type="button" aria-label="Fechar menu">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 2l12 12M14 2L2 14"></path></svg>
    </button>
  </div>
  <ol>
    {links.map((l, i) => (
      <li style={`--i:${i}`}><a href={l.href}><span class="lbl">/{l.act}</span>{l.label}</a></li>
    ))}
  </ol>
  <div class="nav-foot">
    <span>Efeitos pesados demais no seu aparelho?</span>
    <button class="toggle" id="liteNav" type="button" aria-pressed="false">Modo leve</button>
  </div>
</nav>
