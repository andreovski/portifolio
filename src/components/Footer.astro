---
import { contact } from '../data/site';
const whatsapp = `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(contact.whatsappText)}`;
---
<footer class="foot">
  <div class="foot-grid">
    <div class="foot-brand">
      <span class="foot-logo">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><g fill="currentColor"><rect x="0" y="0" width="5" height="18"></rect><rect x="13" y="0" width="5" height="18"></rect><rect x="5" y="6.5" width="8" height="5"></rect></g></svg>
        <span class="d">DECO_</span>
      </span>
      <span class="small">© 2026 ANDRÉ LUIZ</span>
      <button class="toggle" id="liteFoot" type="button" aria-pressed="false">Modo leve</button>
    </div>
    <nav class="foot-col" aria-label="Navegação do rodapé">
      <span class="d up foot-h">Navegação</span>
      <a class="navlink" href="#inicio">Início</a>
      <a class="navlink" href="#manifesto">Manifesto</a>
      <a class="navlink" href="#servicos">Serviços</a>
      <a class="navlink" href="#projetos">Projetos</a>
      <a class="navlink" href="#processo">Processo</a>
      <a class="navlink" href="#contato">Contato</a>
    </nav>
    <div class="foot-col">
      <span class="d up foot-h">Projetos</span>
      <a class="navlink" href="https://www.arttevo.com" target="_blank" rel="noopener">Arttevo</a>
      <a class="navlink" href="https://jottape-web-production.up.railway.app" target="_blank" rel="noopener">Jottape</a>
      <span>Roda Junto</span>
      <span>GoWorkout</span>
    </div>
    <div class="foot-col">
      <span class="d up foot-h">Canais</span>
      <a class="navlink" href={whatsapp} target="_blank" rel="noopener">WhatsApp</a>
      <a class="navlink" href={`mailto:${contact.email}`}>E-mail</a>
      <a class="navlink" href={contact.github} target="_blank" rel="noopener">GitHub</a>
    </div>
    <div class="foot-col">
      <span class="d up foot-h">Fuso</span>
      <span class="tz">BRASÍLIA <span class="acc">+</span> UTC−3</span>
      <span class="d foot-clock" data-clock="s">--:--:--</span>
    </div>
  </div>
  <div class="hazard" aria-hidden="true">
    <span class="hazard-msg">&gt; <span id="granted">ACESSO LIBERADO</span><span class="blink">_</span></span>
  </div>
</footer>
