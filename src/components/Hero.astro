---
const rowA = ['JavaScript', 'Claude', 'n8n', 'Python', 'TypeScript', 'GPT', 'React', 'Hermes', 'Node.js', 'Next.js'];
const rowB = ['n8n', 'React', 'Claude', 'Next.js', 'JavaScript', 'Hermes', 'Python', 'TypeScript', 'GPT', 'Node.js'];
---
<section class="hero" id="inicio" data-act="00" data-name="Início" data-accent="#c6f432">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="prompt" data-rv="type" style="--d:0"><span class="acc">andre@portfolio</span>:~$ <span id="typed">whoami</span><span class="cursor" aria-hidden="true"></span></p>
      <h1>
        <span class="d hero-name" data-glitch="Deco">Deco</span>
        <span class="hero-sub" data-rv="up" style="--d:3">ANDRÉ LUIZ</span>
      </h1>
      <p class="lede" data-rv="up" style="--d:4">Programador. Crio produtos digitais, automações e agentes de IA que tiram o trabalho repetitivo do seu negócio.</p>

      <div class="tools" aria-label="Tecnologias com que eu trabalho" data-rv="wipe" style="--d:5">
        <div class="marq">
          <ul class="marq-track">{rowA.map((t) => <li><i aria-hidden="true"></i>{t}</li>)}</ul>
          <ul class="marq-track" aria-hidden="true">{rowA.map((t) => <li><i></i>{t}</li>)}</ul>
        </div>
        <div class="marq rev" aria-hidden="true">
          <ul class="marq-track">{rowB.map((t) => <li><i></i>{t}</li>)}</ul>
          <ul class="marq-track">{rowB.map((t) => <li><i></i>{t}</li>)}</ul>
        </div>
      </div>

      <p class="avail" data-rv="up" style="--d:6"><i aria-hidden="true"></i><span>Aberto a novos projetos · <span data-clock="m">--:--</span> em Brasília</span></p>
      <div class="hero-cta" data-rv="up" style="--d:7">
        <a class="btn-solid btn-lg" href="#projetos">Ver projetos</a>
        <a class="btn-ghost btn-lg" href="#contato">Falar comigo</a>
      </div>
    </div>

    <div class="portrait">
      <canvas id="ascii" role="img" aria-label="Retrato de André desenhado com caracteres e símbolos"></canvas>
    </div>
  </div>
</section>
