---
const projects = [
  {
    name: 'Arttevo', kind: 'SAAS B2B', fit: 'phone',
    img: '/img/arttevo.webp', w: 520, h: 1125,
    alt: 'Página inicial do Arttevo no celular: Sua gráfica em um só fluxo',
    text: 'Sistema de gestão para gráficas: orçamento, produção, financeiro e ferramentas de arte DTF num fluxo só. O cliente monta a própria folha e aprova o orçamento por link.',
    tags: 'DTF · KANBAN · PORTAL DO CLIENTE',
    href: 'https://www.arttevo.com', label: 'Visitar arttevo.com',
  },
  {
    name: 'Jottape', kind: 'PWA COM IA', fit: 'phone',
    img: '/img/jottape.webp', w: 520, h: 1125,
    alt: 'Tela Hoje do Jottape com briefing de IA, saldo e próximos compromissos',
    text: 'Agenda, tarefas e dinheiro num app só, com uma assistente de IA por voz que transforma o que você fala em tarefas.',
    tags: 'HOJE · AGENDA · JOTTA · TAREFAS · FINANÇAS',
    href: 'https://jottape-web-production.up.railway.app', label: 'Abrir o Jottape',
  },
  {
    name: 'Roda Junto', kind: 'APP MOBILE', fit: 'free',
    img: '/img/roda-junto.webp', w: 520, h: 940,
    alt: 'Tela Passaporte do Roda Junto, com perfil verificado, 9.340 km validados e emblemas conquistados',
    text: 'Comunidade de motociclistas com viagens e quilômetros validados, perfil verificado e emblemas por conquista, como um passaporte de estrada.',
    tags: '1.000 KM · 5 SERRAS · BOA ANFITRIÃ',
  },
  {
    name: 'GoWorkout', kind: 'APP MOBILE', fit: 'full',
    img: '/img/goworkout.webp', w: 1200, h: 900,
    alt: 'Três telas do GoWorkout: treinos disponíveis, atividades do dia e corrida coletiva com percurso no mapa',
    text: 'App de academia com treinos guiados, aulas com horário e vagas, e corridas coletivas com o percurso no mapa.',
    tags: 'FITNESS · AGENDA · MAPAS',
  },
];
---
<section class="sec pad-wide" id="projetos" data-act="03" data-name="Projetos" data-accent="#3ddcf5">
  <div class="rail plus-col l" aria-hidden="true">{Array.from({ length: 10 }, () => <span>+</span>)}</div>
  <div class="rail plus-col r" aria-hidden="true">{Array.from({ length: 10 }, () => <span>+</span>)}</div>
  <div class="inner">
    <div class="sec-head">
      <span class="acc" data-scramble>/03</span>
      <h2 class="d up" data-scramble>Quatro produtos que eu fundei e desenvolvi</h2>
      <span class="sec-tag" data-scramble>PROJETOS · PAPEL: FUNDADOR E DESENVOLVEDOR</span>
    </div>
    <div class="work-grid">
      {projects.map((p, i) => (
        <article class="work" data-rv="work" style={`--d:${i}`}>
          <div class={`shot fit-${p.fit}`}>
            <span class="scn" data-scramble>//SCN_0{i + 1}</span>
            <span class="pic"><img src={p.img} width={p.w} height={p.h} alt={p.alt} loading="lazy" decoding="async" /></span>
          </div>
          <div class="work-body">
            <div class="work-head">
              <div class="work-title">
                <h3 class="d up">{p.name}</h3>
                <span class="kind">{p.kind}</span>
              </div>
              {p.href ? (
                <a class="arrowbox" href={p.href} target="_blank" rel="noopener" aria-label={p.label}><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 11L11 3M5 3h6v6"></path></svg></a>
              ) : (
                <span class="soon">EM BREVE</span>
              )}
            </div>
            <p class="muted">{p.text}</p>
            <p class="tagline">{p.tags}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
