    gallery: [
      { src: '/img/projetos/jottape-desktop.webp', w: 1440, h: 900, alt: 'Jottape no computador: tela Hoje com menu lateral, briefing de IA, saldo e tarefas' },
      { src: '/img/projetos/jottape-hoje.webp', w: 780, h: 1688, alt: 'Tela Hoje do Jottape no celular' },
