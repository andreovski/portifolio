type Shot = { src: string; w: number; h: number; alt: string };
---
<section class="sec pad-wide" id="projetos" data-act="03" data-name="Projetos" data-accent="#3ddcf5">
  <div class="rail plus-col l" aria-hidden="true">{Array.from({ length: 10 }, () => <span>+</span>)}</div>
  <div class="rail plus-col r" aria-hidden="true">{Array.from({ length: 10 }, () => <span>+</span>)}</div>
  <div class="inner">
    <div class="sec-head">
      <span class="acc" data-scramble>/03</span>
      <h2 class="d up" data-scramble>Produtos que eu criei e desenvolvi</h2>
      <span class="sec-tag" data-scramble>PROJETOS · DA IDEIA AO AR</span>
    </div>
    <div class="work-grid">
      {projects.map((p, i) => (
        <article class={`work${p.gallery ? ' has-gallery' : ''}`} data-rv="work" style={`--d:${i}; view-transition-name: proj-${i + 1}`} id={`proj-${i + 1}`}>
          <div class={`shot fit-${p.fit}`}>
            <span class="scn" data-scramble>//SCN_0{i + 1}</span>
            <span class="pic"><img src={p.img} width={p.w} height={p.h} alt={p.alt} loading="lazy" decoding="async" /></span>
            {p.gallery && (
              <button class="expand" type="button" aria-expanded="false" aria-controls={`gal-${i + 1}`} aria-label={`Ver ${p.gallery.length} imagens de ${p.name}`}>
                <span class="expand-tag"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M1 5V1h4M11 1h4v4M15 11v4h-4M5 15H1v-4"></path></svg>+{p.gallery.length} IMAGENS</span>
              </button>
            )}
          </div>
          {p.gallery && (
            <div class="gallery" id={`gal-${i + 1}`} role="region" aria-label={`Imagens de ${p.name}`} hidden>
              <div class="gal-bar">
                <span class="scn-static">//SCN_0{i + 1} · {p.name.toUpperCase()}</span>
                <span class="gal-count" aria-live="polite"><b>01</b>/{String(p.gallery.length).padStart(2, '0')}</span>
                <button class="gal-close" type="button" aria-label="Fechar imagens"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 2l12 12M14 2L2 14"></path></svg></button>
              </div>
              <ul class="gal-track" tabindex="0" aria-label="Arraste ou use as setas para ver as imagens">
                {p.gallery.map((g, k) => (
                  <li class={g.w > g.h ? 'wide' : 'tall'} style={`--k:${k}; --ar:${g.w}/${g.h}`}><img src={g.src} width={g.w} height={g.h} alt={g.alt} loading="lazy" decoding="async" /></li>
                ))}
              </ul>
              <div class="gal-nav">
                <button class="gal-prev" type="button" aria-label="Imagem anterior"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 2L4 7l5 5"></path></svg></button>
                <div class="gal-seg" aria-hidden="true">{p.gallery.map((_, k) => <span class={k === 0 ? 'on' : ''}></span>)}</div>
                <button class="gal-next" type="button" aria-label="Próxima imagem"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 2l5 5-5 5"></path></svg></button>
              </div>
            </div>
          )}
          <div class="work-body">
            <div class="work-head">
              <div class="work-title">
                <h3 class="d up">{p.name}</h3>
                <span class="kind">{p.kind}</span>
              </div>
              {p.href ? (
                <a class="arrowbox" href={p.href} target="_blank" rel="noopener" aria-label={p.label}><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 11L11 3M5 3h6v6"></path></svg></a>
              ) : p.badge !== '' && (
                <span class="soon">{p.badge ?? 'EM BREVE'}</span>
              )}
            </div>
            <p class="muted">{p.text}</p>
            <p class="tagline">{p.tags}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
